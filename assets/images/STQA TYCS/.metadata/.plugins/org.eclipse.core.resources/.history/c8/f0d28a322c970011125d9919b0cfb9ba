package prac;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.edge.EdgeDriver;
import org.openqa.selenium.support.ui.Select;



public class DropdownComboBoxTest {
	public static void main(String[] args) {

        
        System.setProperty("webdriver.msedge.driver","D:\\STQA TYCS\\practical\\msedgedriver.exe");
       
        WebDriver driver = new EdgeDriver();

        
        driver.get("D:\\STQA TYCS");

        driver.manage().window().maximize();


        
        
        WebElement countryDropdown =
                driver.findElement(By.id("country"));

        Select country = new Select(countryDropdown);


        
        List<WebElement> countryList =country.getOptions();

        System.out.println("Total Dropdown Items: "+ countryList.size());



        System.out.println("Dropdown Values:");

        for(WebElement option : countryList) {
            System.out.println(option.getText());
        }


       
        String defaultValue =country.getFirstSelectedOption().getText();

        System.out.println("Default Selected Value: "+ defaultValue);


        if(defaultValue.equals("India")) {
            System.out.println("Default value validation PASSED");
        }
        else {
            System.out.println("Default value validation FAILED");
        }


       

        country.selectByIndex(2);

        System.out.println("Selected by Index: "+ country.getFirstSelectedOption().getText());


        country.selectByVisibleText("Canada");

        System.out.println("Selected by Text: "+ country.getFirstSelectedOption().getText());


        country.selectByValue("AU");

        System.out.println("Selected by Value: "+ country.getFirstSelectedOption().getText());



       
        WebElement cityBox =driver.findElement(By.id("cityBox"));


        cityBox.sendKeys("M");


       
        List<WebElement> suggestions =driver.findElements(By.className("item"));


       

        System.out.println("\nTotal Combo Box Items: "
                + suggestions.size());


        

        System.out.println("Combo Box Suggestions:");

        for(WebElement item : suggestions) {

            System.out.println(item.getText());

        }


        

        for(WebElement item : suggestions) {

            if(item.getText().equals("Mumbai")) {

                item.click();
                break;
            }
        }


        System.out.println("Selected City: " + cityBox.getAttribute("value"));




        WebElement submitButton =driver.findElement(By.id("submit"));

        submitButton.click();

        System.out.println("Submit button clicked");


        
        driver.quit();
    }

}
